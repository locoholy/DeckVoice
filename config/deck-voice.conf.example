# DeckVoice — настройки. Скопируй в ~/.config/deck-voice/config и правь.
# Файл подключается как обычный bash, синтаксис КЛЮЧ="значение".

# Модель. small — хороший баланс для русского. tiny быстрее, но врёт.
#MODEL="$HOME/.local/share/deck-voice/models/ggml-small.bin"

# Язык распознавания
#LANGUAGE="ru"

# Потоков whisper. У Deck 4 ядра; больше 4 обычно не ускоряет.
#THREADS=4

# Усиление микрофона. 150% даёт клиппинг и портит распознавание.
#MIC_BOOST="130%"

# Чем вставлять. В терминале Ctrl+V не работает — там нужен ctrl-shift-v.
# none = только положить в буфер, вставишь сам.
#PASTE_KEY="ctrl-v"

# Порог тишины и минимальная длительность
#MIN_PEAK="0.008"
#MIN_DURATION="0.5"

# Сколько логов хранить
#LOG_KEEP=5

# Уведомления на экране
#NOTIFY=1

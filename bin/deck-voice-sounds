#!/bin/bash
# Генератор звуковой темы DeckVoice.
#
# Почему звуки генерируются, а не лежат в репозитории готовыми файлами:
#
#   1. Лицензии. Проект публикуется, а чужие звуки тянут за собой условия
#      распространения. Синтезированные — свои, вопросов нет.
#   2. Рецепт понятнее блоба. Захочешь другой тон или длительность — правишь
#      число здесь, а не ищешь новый файл.
#   3. Штатные звуки KDE не подходят по существу: Oxygen-Sys-App-Message
#      длится 1,3 с, List-End и Positive — по 2,1 с. Для отклика на нажатие
#      кнопки это вечность, звук ещё тянется, когда всё давно произошло.
#
# Чем они отличаются на слух: короткие (150–300 мс), почти чистые синусы с
# мягкой атакой и экспоненциальным затуханием — то есть без резкого щелчка в
# начале и без хвоста в конце. Две ноты интервалом в квинту: вверх — «начал
# слушать», вниз — «закончил». Направление считывается без слов.

set -euo pipefail

OUT="${1:-$HOME/.local/share/deck-voice/sounds}"
mkdir -p "$OUT"

command -v ffmpeg >/dev/null || { echo "нужен ffmpeg"; exit 1; }

# нота ЧАСТОТА ДЛИТЕЛЬНОСТЬ ГРОМКОСТЬ ЗАДЕРЖКА_МС → кусок filter_complex
# Атака 6 мс убирает щелчок, экспоненциальное затухание даёт колокольчик,
# а не гудок.
note() {
  local idx="$1" freq="$2" dur="$3" vol="$4" delay="$5"
  printf '[%d:a]afade=t=in:st=0:d=0.006,afade=t=out:st=0.015:d=%s:curve=exp,volume=%s,adelay=%s|%s[n%d];' \
    "$idx" "$(awk -v d="$dur" 'BEGIN{printf "%.3f", d-0.015}')" "$vol" "$delay" "$delay" "$idx"
}

src() { printf -- '-f lavfi -i sine=frequency=%s:duration=%s:sample_rate=48000 ' "$1" "$2"; }

# make ИМЯ "ЧАСТОТА:ДЛИТ:ГРОМК:ЗАДЕРЖКА" ...
make() {
  local name="$1"; shift
  local inputs="" filters="" mix="" i=0
  for spec in "$@"; do
    IFS=: read -r f d v dl <<<"$spec"
    inputs+="$(src "$f" "$d")"
    filters+="$(note "$i" "$f" "$d" "$v" "$dl")"
    mix+="[n$i]"
    i=$((i + 1))
  done
  # lowpass срезает призвуки от резкого затухания — именно он делает звук
  # «мягким», а не звонким.
  local chain="${filters}${mix}amix=inputs=$i:normalize=0,lowpass=f=5200,aformat=sample_fmts=s16:channel_layouts=stereo"
  # shellcheck disable=SC2086
  ffmpeg -nostdin -loglevel error -y $inputs -filter_complex "$chain" \
    -c:a pcm_s16le -f wav "$OUT/.$name.wav"

  # Нормализация. Сложение нот через amix без normalize и последующий lowpass
  # роняют пик примерно до 0,05 — на слух это тишина. Поэтому вторым проходом
  # подтягиваем пик к 0,8: дальше громкостью заведует SOUND_VOLUME в конфиге,
  # и она должна работать от предсказуемого уровня.
  local gain
  gain=$(ffmpeg -nostdin -loglevel info -i "$OUT/.$name.wav" -af volumedetect \
           -f null - 2>&1 | grep -oP 'max_volume:\s*\K-?[0-9.]+' | tail -1)
  gain=$(LC_ALL=C awk -v g="${gain:-0}" 'BEGIN{ printf "%.2f", -g - 1.9 }')
  ffmpeg -nostdin -loglevel error -y -i "$OUT/.$name.wav" \
    -af "volume=${gain}dB" -c:a libvorbis -q:a 3 "$OUT/$name.ogg"
  rm -f "$OUT/.$name.wav"
  printf '  %-16s %s\n' "$name.ogg" \
    "$(LC_ALL=C ffprobe -v error -show_entries format=duration -of csv=p=0 "$OUT/$name.ogg" \
       | LC_ALL=C awk '{printf "%.0f мс", $1*1000}'), $(stat -c%s "$OUT/$name.ogg") Б"
}

echo "Собираю звуки в $OUT"

# Начал слушать: квинта вверх, G5 → D6. Движение вверх = «поехали».
make listen-start  784:0.26:0.55:0   1175:0.24:0.42:85

# Закончил слушать: та же квинта вниз — зеркальный ответ первому.
make listen-stop   1175:0.24:0.45:0  784:0.28:0.5:85

# Готово, текст вставлен: обе ноты сразу, короткий мягкий аккорд.
make done          784:0.34:0.42:0   1175:0.32:0.34:0   1568:0.28:0.16:0

# Не получилось: малая секунда вниз, тихо и низко. Не тревога, а «мимо».
make oops          440:0.30:0.4:0    415:0.34:0.4:70

echo
echo "Послушать все:  for f in $OUT/*.ogg; do paplay \"\$f\"; sleep 0.4; done"

#!/bin/bash
# DeckVoice — голосовой ввод для Steam Deck.
#
# Одна кнопка: первое нажатие — запись, второе — распознавание и вставка
# в активное поле. Работает в Plasma Wayland.
#
# Команды:
#   deck-dictation            переключить запись (для горячей клавиши)
#   deck-dictation status     что установлено и работает ли
#   deck-dictation logs       показать последний лог
#   deck-dictation test       прогнать распознавание на тишине (проверка модели)
#
# Отладка:  DECKVOICE_DEBUG=1 deck-dictation

set -uo pipefail

# ─────────────────────────── окружение ───────────────────────────
export HOME="${HOME:-/home/deck}"
export PATH="$HOME/.local/bin:/usr/bin:/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DISPLAY="${DISPLAY:-:0}"
export YDOTOOL_SOCKET="${YDOTOOL_SOCKET:-$XDG_RUNTIME_DIR/.ydotool_socket}"
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"
for f in "$XDG_RUNTIME_DIR"/xauth_*; do
  [[ -r "$f" ]] && export XAUTHORITY="$f" && break
done

# ─────────────────────────── настройки ───────────────────────────
# Всё переопределяется в ~/.config/deck-voice/config
RUNTIME_DIR="$HOME/.local/share/deck-voice"
MODEL="$RUNTIME_DIR/models/ggml-small.bin"
PYLIB="$RUNTIME_DIR/pylib"
PYTHON="/usr/bin/python3"
LANGUAGE="ru"
THREADS=4
MIC_BOOST="130%"          # 150% давало клиппинг
MIN_DURATION="0.5"        # короче — считаем промахом
MIN_PEAK="0.008"          # тише — считаем тишиной
PASTE_KEY="ctrl-v"        # ctrl-v | ctrl-shift-v | none
LOG_KEEP=5                # сколько логов хранить
NOTIFY=1

CONFIG="${DECKVOICE_CONFIG:-$HOME/.config/deck-voice/config}"
[[ -r "$CONFIG" ]] && . "$CONFIG"

DEBUG="${DECKVOICE_DEBUG:-0}"

# ─────────────────────────── состояние ───────────────────────────
STATE_DIR="$XDG_RUNTIME_DIR/deck-voice"
mkdir -p "$STATE_DIR"
PIDFILE="$STATE_DIR/record.pid"
WAV="$STATE_DIR/rec.wav"
LOG_DIR="$HOME/.local/state/deck-voice"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/current.log"

# ─────────────────────────── логирование ─────────────────────────
log()   { printf '%s [%s] %s\n' "$(date '+%H:%M:%S.%3N')" "${2:-INFO}" "$1" >>"$LOG"; }
debug() { [[ "$DEBUG" == "1" ]] && log "$1" DEBUG || true; }
err()   { log "$1" ERROR; }

rotate_log() {
  [[ -f "$LOG" ]] && mv "$LOG" "$LOG_DIR/$(date +%Y%m%d-%H%M%S).log"
  ls -1t "$LOG_DIR"/*.log 2>/dev/null | tail -n +$((LOG_KEEP + 1)) | xargs -r rm -f
  : >"$LOG"
}

# засечь время: t_start NAME / t_end NAME
declare -A _T
t_start() { _T[$1]=$(date +%s%N); }
t_end()   { local d=$(( ($(date +%s%N) - ${_T[$1]:-0}) / 1000000 )); log "$1: ${d} мс" TIME; }

notify() {
  [[ "$NOTIFY" == "1" ]] || return 0
  notify-send -u critical -a "Голосовой ввод" -t "${3:-6000}" \
    -i audio-input-microphone "$1" "$2" 2>>"$LOG" || true
}

# ─────────────────────────── буфер обмена ────────────────────────
# wl-clipboard в SteamOS не установлен, а корень только для чтения.
# Klipper из Plasma уже работает в сессии и умеет ровно это.
copy_to_clipboard() {
  local text="$1" q
  for q in qdbus6 qdbus; do
    command -v "$q" >/dev/null 2>&1 || continue
    if "$q" org.kde.klipper /klipper setClipboardContents "$text" 2>>"$LOG"; then
      debug "буфер: через $q"
      return 0
    fi
  done
  if command -v wl-copy >/dev/null 2>&1; then
    printf '%s' "$text" | wl-copy 2>>"$LOG" && { debug "буфер: через wl-copy"; return 0; }
  fi
  return 1
}

send_paste() {
  [[ "$PASTE_KEY" == "none" ]] && { notify "Готово" "Текст в буфере — вставь сам" 5000; return 0; }
  if [[ ! -x $HOME/.local/bin/ydotool || ! -S ${YDOTOOL_SOCKET} ]]; then
    err "ydotool недоступен (демон не запущен?)"
    notify "Готово" "Текст в буфере — нажми Ctrl+V" 5000
    return 1
  fi
  case "$PASTE_KEY" in
    ctrl-shift-v) $HOME/.local/bin/ydotool key 29:1 42:1 47:1 47:0 42:0 29:0 2>>"$LOG" ;;
    *)            $HOME/.local/bin/ydotool key 29:1 47:1 47:0 29:0 2>>"$LOG" ;;
  esac
}

paste_text() {
  local text="$1"
  [[ -n "$text" ]] || return 0
  if ! copy_to_clipboard "$text"; then
    err "не удалось положить в буфер"
    notify "⚠️ Буфер недоступен" "$text" 10000
    return 1
  fi
  sleep 0.15
  send_paste
}

# ─────────────────────────── запись ──────────────────────────────
is_recording() {
  [[ -f $PIDFILE ]] || return 1
  local pid; pid=$(cat "$PIDFILE" 2>/dev/null || true)
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

stop_recorder() {
  local pid; pid=$(cat "$PIDFILE" 2>/dev/null || true)
  if [[ -n $pid ]]; then
    # SIGINT, чтобы рекордер дописал заголовок WAV
    kill -INT "$pid" 2>/dev/null || true
    for _ in $(seq 1 10); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    kill -KILL "$pid" 2>/dev/null || true
  fi
  pkill -f "parecord.*deck-voice/rec.wav" 2>/dev/null || true
  pkill -f "pw-record.*deck-voice/rec.wav" 2>/dev/null || true
  rm -f "$PIDFILE"
  sleep 0.2
}

# ─────────────────────────── распознавание ───────────────────────
transcribe() {
  PYTHONPATH="$PYLIB" "$PYTHON" - "$MODEL" "$WAV" "$LANGUAGE" "$THREADS" "$MIN_DURATION" "$MIN_PEAK" <<'PY'
import sys, wave, re
from pathlib import Path
import numpy as np

model_path, wav, lang, threads, min_dur, min_peak = sys.argv[1:7]
threads = int(threads); min_dur = float(min_dur); min_peak = float(min_peak)

if not Path(wav).exists() or Path(wav).stat().st_size < 1000:
    print("", end=""); raise SystemExit(0)

with wave.open(wav, "rb") as w:
    rate, ch = w.getframerate(), w.getnchannels()
    raw = w.readframes(w.getnframes())

s = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
if ch == 2:
    s = s.reshape(-1, 2).mean(axis=1)
if rate != 16000 and len(s):
    n = max(1, int(len(s) / rate * 16000))
    s = np.interp(np.linspace(0, len(s), n, endpoint=False), np.arange(len(s)), s).astype(np.float32)

dur = len(s) / 16000.0
peak = float(np.max(np.abs(s))) if len(s) else 0.0
print(f"__META__ dur={dur:.2f} peak={peak:.4f}", file=sys.stderr)
if dur < min_dur or peak < min_peak:
    print("", end=""); raise SystemExit(0)

from pywhispercpp.model import Model
m = Model(model_path, n_threads=threads, no_timestamps=True, no_context=True,
          suppress_blank=True, no_speech_thold=0.55, temperature=0.0)

# Известные галлюцинации Whisper на русском (следы обучения на субтитрах)
JUNK = ("редактор субтитров", "продолжение следует", "субтитры делал",
        "аплодисмент", "музыка играет")
parts = []
for seg in m.transcribe(s, language=lang):
    t = (getattr(seg, "text", None) or str(seg) or "").strip()
    t = t.lstrip("-—– ").strip()
    t = re.sub(r"\[[^\]]*\]", "", t)
    t = re.sub(r"\([^)]*\)", "", t).strip()
    if any(j in t.lower() for j in JUNK):
        continue
    if len(t) < 2 or t in (".", "..", "...", "…"):
        continue
    parts.append(t)

text = " ".join(parts).strip()
text = re.sub(r"(.{6,40}?)(?:\s*\1){2,}", r"\1", text)   # схлопнуть зацикливание
if not re.search(r"[\wа-яА-Я]", text):
    text = ""
print(text, end="")
PY
}

# ─────────────────────────── команды ─────────────────────────────
cmd_status() {
  echo "DeckVoice"
  echo "  модель:      $MODEL $([ -f "$MODEL" ] && echo "($(du -h "$MODEL" | cut -f1))" || echo "— НЕТ")"
  echo "  библиотеки:  $PYLIB $([ -d "$PYLIB" ] && echo OK || echo "— НЕТ")"
  echo "  язык:        $LANGUAGE, потоков: $THREADS"
  echo "  вставка:     $PASTE_KEY"
  printf "  ydotoold:    "; pgrep -x ydotoold >/dev/null && echo "работает" || echo "НЕ РАБОТАЕТ"
  printf "  сокет:       "; [ -S "$YDOTOOL_SOCKET" ] && echo "есть" || echo "НЕТ"
  printf "  Klipper:     "; (qdbus6 org.kde.klipper /klipper getClipboardContents >/dev/null 2>&1 && echo "отвечает") || echo "НЕ ОТВЕЧАЕТ"
  printf "  микрофон:    "; pactl get-default-source 2>/dev/null || echo "?"
  printf "  запись идёт: "; is_recording && echo "да" || echo "нет"
  echo "  логи:        $LOG_DIR"
}

cmd_logs() { [[ -f "$LOG" ]] && cat "$LOG" || echo "лога нет"; }

cmd_test() {
  echo "Проверяю загрузку модели (без звука)…"
  t_start model
  PYTHONPATH="$PYLIB" "$PYTHON" -c "
from pywhispercpp.model import Model
import sys
m = Model('$MODEL', n_threads=$THREADS)
print('модель загружена:', '$MODEL'.split('/')[-1])
" 2>&1 | grep -viE "^whisper_|^ggml|^register" | head -3
  t_end model
  echo "Тайминг записан в $LOG"
}

# ─────────────────────────── основной цикл ───────────────────────
case "${1:-toggle}" in
  status) cmd_status; exit 0 ;;
  logs)   cmd_logs;   exit 0 ;;
  test)   cmd_test;   exit 0 ;;
  toggle) ;;
  *) echo "Использование: deck-dictation [toggle|status|logs|test]"; exit 1 ;;
esac

# ---------- ОСТАНОВКА: распознать и вставить ----------
if is_recording; then
  log "=== СТОП, обрабатываю ==="
  t_start total
  stop_recorder
  notify "⏳ Обработка…" "Распознаю речь" 8000

  sz=$(stat -c%s "$WAV" 2>/dev/null || echo 0)
  log "размер записи: $sz байт"
  if [[ ! -f $WAV || $sz -lt 2000 ]]; then
    err "запись пустая или слишком короткая"
    notify "⚠️ Пусто" "Слишком короткая запись — говори 2–5 секунд" 5000
    exit 0
  fi

  t_start whisper
  TEXT="$(transcribe 2>>"$LOG" || true)"
  t_end whisper
  log "распознано: [$TEXT]"

  if [[ -z ${TEXT// /} ]]; then
    err "текст пустой"
    notify "⚠️ Ничего не распознано" "Говори громче и ближе к микрофону" 7000
    exit 0
  fi

  t_start paste
  if paste_text "$TEXT"; then
    t_end paste
    notify "✅ Вставлено" "$TEXT" 8000
    log "успешно"
  else
    t_end paste
    log "вставка не удалась, текст в буфере" WARN
  fi
  t_end total
  exit 0
fi

# ---------- СТАРТ: начать запись ----------
rotate_log
log "=== СТАРТ ==="
debug "модель=$MODEL язык=$LANGUAGE потоков=$THREADS вставка=$PASTE_KEY"

if [[ ! -f $MODEL ]]; then
  err "модель не найдена: $MODEL"
  notify "Ошибка" "Нет модели. Проверь: deck-dictation status" 6000
  exit 1
fi
if [[ ! -d $PYLIB ]]; then
  err "нет каталога библиотек: $PYLIB"
  notify "Ошибка" "Нет python-библиотек. Проверь: deck-dictation status" 6000
  exit 1
fi

stop_recorder 2>/dev/null || true
rm -f "$WAV"

pactl set-source-mute @DEFAULT_SOURCE@ 0 2>/dev/null || true
pactl set-source-volume @DEFAULT_SOURCE@ "$MIC_BOOST" 2>/dev/null || true
debug "микрофон: $(pactl get-default-source 2>/dev/null), усиление $MIC_BOOST"

if command -v parecord >/dev/null; then
  parecord --channels=1 --rate=16000 --file-format=wav "$WAV" >>"$LOG" 2>&1 &
else
  pw-record --channels=1 --rate=16000 "$WAV" >>"$LOG" 2>&1 &
fi
echo $! >"$PIDFILE"
log "запись пошла, pid=$(cat "$PIDFILE")"
notify "🔴 СЛУШАЮ" "Говори… Ещё раз кнопку = стоп" 60000
exit 0
